{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Semantica ERP API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Introducción",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Auth",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "POST /auth/login",
              "POST /auth/register"
            ]
          },
          {
            "group": "Recurso Humano",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /rhu/empleados"
            ]
          },
          {
            "group": "Transporte y Logística",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /tte/guia"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentación",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:soporte@semanticaapi.com.co"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}
